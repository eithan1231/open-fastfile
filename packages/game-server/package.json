{
  "name": "@3d/game-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "One match, hosted: geckos.io transport, the authoritative simulation, no disk",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/index.ts",
    "start": "node --conditions=dist --env-file-if-exists=../../.env.local dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "world": "tsx --env-file-if-exists=../../.env.local scripts/world.ts"
  },
  "dependencies": {
    "@3d/shared": "workspace:*",
    "@geckos.io/server": "^3.1.0",
    "reflect-metadata": "^0.2.2",
    "three": "catalog:",
    "tsyringe": "^4.10.0"
  },
  "devDependencies": {
    "@3d/api": "workspace:*",
    "@types/node": "^26.4.1",
    "@types/three": "catalog:",
    "tsx": "^4.19.2",
    "typescript": "catalog:"
  }
}
