# Copy to .env.local (gitignored) and edit. Nothing here is required to run
# locally: every value below is the default, and `pnpm dev` plus
# `pnpm dev:game-server` work on a fresh clone with no file at all.
#
# Who reads what: DEV_* is read by Vite only, at config time, and never reaches
# the browser bundle (loadEnv filters by prefix). The two servers read this file
# through node's --env-file-if-exists, wired into their dev/start scripts.

# --- the client's dev server (Vite) ---------------------------------------
# Serve beyond localhost. Set the host to 0.0.0.0 and name the hostnames Vite
# should answer to, or it refuses the request.
DEV_HOST=localhost
DEV_ALLOWED_HOSTS=
# Where Vite proxies /worlds*, /worlds-manifest.json and /api/* to.
DEV_API_URL=http://localhost:9208

# --- @3d/api: the HTTP authority ------------------------------------------
API_PORT=9208
# The worlds volume. The deployed image carries none; this is mounted over.
WORLDS_ROOT=./worlds
# The built client, served at /. Unset in dev, where Vite serves it.
# CLIENT_DIST=packages/client/dist
# Users, sessions and the games that were played. Migrations run on open, so
# there is nothing to do before the first boot.
DB_PATH=./.data/server.sqlite
# How long a signed-in browser stays signed in.
SESSION_TTL_DAYS=30

# --- matchmaking (the api decides all of this) -----------------------------
# The playlist, comma-separated. Every entry is always available: an instance
# loads whatever map it is ordered to host, so this is not narrowed by what the
# fleet happens to be running. The default is the committed hand-authored world,
# which a fresh clone can run -- but note it has no SERVER collision, so
# simulated players fall forever on it. Point this at an imported map for a real
# game.
MATCHMAKING_MAPS=dome-mw3
# How often the queue is looked at. Well under the countdown, since this is what
# notices it has run out.
MATCHMAKING_INTERVAL_MS=1000
# Players in one game, and the number below which a lobby waits.
LOBBY_SIZE=12
LOBBY_MIN_PLAYERS=2
# The window players spend looking at each other, and at the map, before a round.
LOBBY_COUNTDOWN_SECONDS=30
# How long a round runs. The api owns the playlist, so it owns this; a game
# server is told, per game.
GAME_DURATION_SECONDS=600
# How long a committed game may take to report ready before its lobby gives up
# and reopens. Until that report the players are standing in a closed lobby with
# nowhere to go, and an instance that crashed or restarted never sends one.
GAME_READY_TIMEOUT_SECONDS=30
# How long a player may have no event stream before they are dropped from a
# lobby. That stream is the only liveness signal a browser gives us.
LOBBY_PRESENCE_TIMEOUT_MS=30000

# --- @3d/game-server: one match -------------------------------------------
GAME_PORT=9300
# The UDP port the browser's DataChannel talks over -- ONE port, the same at both
# ends. geckos multiplexes every connection onto a single socket and picks its
# port from the range at random, so a range and a forwarded port agree by luck
# only. Each instance on a host needs its own: two sharing one fails as a silent
# ICE timeout. This is the port to forward.
UDP_PORT_MIN=20000
UDP_PORT_MAX=20000
# The address a player reaches that port on. A game server gathers one candidate
# per interface and every one of them is private behind a NAT, so unless the
# forwarded address is declared here, no browser is ever told it exists and the
# connection dies as a silent ICE timeout. Unset means "advertise nothing", which
# is what dev wants and what a host whose own interface already carries its
# public address wants too. Never inferred from PUBLIC_URL: a name that resolves
# to a proxy or a CDN would hand every player an address nothing is listening
# behind, and it would fail exactly like not setting this at all.
# PUBLIC_IP=203.0.113.7
# Optional, and off: discovering that address rather than declaring it,
# comma-separated. Worth setting behind a cone NAT, where the mapping a stun
# server reports is good for any peer. Useless behind a symmetric NAT, which
# mints a new mapping per destination -- test yours by asking two stun servers
# on DIFFERENT addresses and comparing the port each reports. A turn url goes
# here too, credentials in the string: turn:user:pass@host:3478
ICE_SERVERS=
# The authority. A game server reads no worlds off disk; it fetches them here.
API_URL=http://localhost:9208
# No WORLD here: an instance is not tied to a map. It loads whatever the api
# orders it to host and unloads a map once no game is on it.
# Games this instance will host at once.
MAX_GAMES=4
# How long a game may stand empty before it is over. Players are told about a
# game before they have loaded the world, so a new one is legitimately empty for
# a few seconds; with no window, "empty ends it" would end every game at birth.
GAME_JOIN_GRACE_SECONDS=60
# How a browser reaches this instance — a whole URL, because a fleet behind one
# proxy is reached by path and one with a certificate each is reached by name.
PUBLIC_URL=http://localhost:9300
# Players this instance admits across ALL its games -- what the api uses to stop
# handing work to a loaded instance. A single game's cap is LOBBY_SIZE above.
MAX_PLAYERS=48
# The fixed tick, hertz. The server decides it; every client is told in its
# `joined` and accumulates frames to match, so it is set in one place only.
TICK_RATE=60
# Metres between what a client claims and what re-simulating that ONE step
# produces, before the server says so. A running player covers ~0.1 m in a 60 Hz
# tick. Nothing is corrected at any drift yet.
DRIFT_WARN_METRES=0.05
# The longest the navigation bake holds the event loop before yielding, ms. It
# runs as a world loads and bots stand still until it is done; keep it well under
# a tick, which waits behind it. It does not change how long the bake takes.
NAV_SLICE_MS=5
# SHOTTRACE -- a TEMPORARY diagnostic; see docs/engine/diagnostics-shottrace.md,
# whose last section is how to remove it. Set to 1 to have a game server tell
# each shooter where it thinks their rounds went, so the client's dev view (G)
# can draw its own trace beside the server's. Unset -- the default -- nothing
# extra is sent at all.
# SHOT_TRACE=1

# --- shared between the two servers ---------------------------------------
# What a game server presents to the api. Both fall back to a fixed dev token
# and warn loudly; in production a missing one is fatal on both ends.
SERVICE_TOKEN=
# The origin the client is served from, for geckos' signalling CORS.
CLIENT_ORIGIN=http://localhost:5173

# --- the Call of Duty importer (python3 -m scripts.cod) ----------------------
# Not read from this file: the importer is Python and reads only its own
# environment and cod.config.json (copy cod.config.example.json). Listed here so
# every variable the repo reads is in one place; docs/cod/README.md has the rest.
# A config file other than ./cod.config.json.
# COD_CONFIG=
# One game's install folders, os.pathsep-separated (":" here, ";" on Windows).
# Wins over cod.config.json; --game-dir wins over it. Games: MW2 MW3 BO1 BO2
# GHOSTS AW CW.
# COD_MW3_DIR=
# User-supplied files, each also a cod.config.json key (iw6_durango,
# iw6_durango_types, s1_layout_x360, ooz).
# IW6_DURANGO=
# IW6_DURANGO_TYPES=
# S1_LAYOUT_X360=
# OOZ_LIB=
