{
  "_comment": "What each game's install looks like. Every path is relative to an install root; a game may have several roots (Steam depots downloaded one by one), and each path is looked up in every root, in order. `depots` are the Steam depots of the 32-bit build, in root order, each with the manifest the pipeline was built against; `merge_depots` means the game reads its folders as one tree, so its depots must be copied into one folder. `probe` is an executable read only to tell a 32-bit build from a 64-bit one. Where the roots are: installs.py and cod.config.json (docs/cod/README.md).",
  "mw2": {
    "title": "Modern Warfare 2 (2009)",
    "engine": "iw4",
    "steam": {
      "app": 10190,
      "folder": "Call of Duty Modern Warfare 2"
    },
    "zones": ["zone/english"],
    "search": ["main"],
    "exe": "iw4mp.exe",
    "maps": {
      "match": "^mp_",
      "beside": "{map}_load.ff"
    },
    "depots": [
      {
        "app": 10180,
        "depot": 10182,
        "manifest": "4063260329988186194",
        "holds": "main\\ (the .iwd archives)"
      },
      {
        "app": 10180,
        "depot": 10183,
        "manifest": "8707803059832053468",
        "holds": "zone\\english and main\\"
      }
    ]
  },
  "mw3": {
    "title": "Modern Warfare 3 (2011)",
    "engine": "iw5",
    "steam": {
      "app": 42690,
      "folder": "Call of Duty Modern Warfare 3"
    },
    "zones": ["zone/english", "zone/dlc"],
    "search": ["main"],
    "common": ["zone/english/common_mp.ff", "zone/english/common.ff"],
    "exe": "iw5mp.exe",
    "maps": {
      "match": "^mp_",
      "beside": "{map}_load.ff"
    },
    "depots": [
      {
        "app": 42680,
        "depot": 42683,
        "manifest": "6381783964590594065",
        "holds": "zone\\english (the base multiplayer and Spec Ops maps)"
      },
      {
        "app": 42680,
        "depot": 42682,
        "manifest": "2661317971072643596",
        "holds": "main\\ and zone\\dlc (Terminal, Aground, Courtyard)"
      },
      {
        "app": 42690,
        "depot": 42698,
        "manifest": "5997898371746217629",
        "holds": "zone\\dlc (the five Collection maps)"
      },
      {
        "app": 42690,
        "depot": 42691,
        "manifest": "4104640605720756125",
        "holds": "the 32-bit iw5mp.exe (optional: read for wavelet images)"
      }
    ]
  },
  "bo1": {
    "title": "Black Ops",
    "engine": "t5",
    "steam": {
      "app": 42710,
      "folder": "Call of Duty Black Ops"
    },
    "zones": ["zone/Common"],
    "search": ["main"],
    "exe": "BlackOpsMP.exe",
    "maps": {
      "match": "^(mp|zombie)_",
      "exclude": "_patch$"
    },
    "merge_depots": true,
    "depots": [
      {
        "app": 42700,
        "depot": 42702,
        "manifest": "6257032900290287777",
        "holds": "zone\\Common (every map) and main\\"
      },
      {
        "app": 42700,
        "depot": 42703,
        "manifest": "8741537774138455205",
        "holds": "zone\\English (the zombies maps' en_ zones) and main\\"
      },
      {
        "app": 42710,
        "depot": 42704,
        "manifest": "2396700113547373447",
        "holds": "BlackOpsMP.exe (optional: read for wavelet images)"
      }
    ]
  },
