{
  "name": "3d-designer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser 3D engine for walkable worlds, authored as plain-text .world files",
  "scripts": {
    "dev": "pnpm --parallel --filter @3d/client --filter @3d/api dev",
    "dev:mp": "pnpm --parallel --filter @3d/client --filter @3d/api --filter @3d/game-server dev",
    "dev:client": "pnpm --filter @3d/client dev",
    "dev:api": "pnpm --filter @3d/api dev",
    "dev:game-server": "pnpm --filter @3d/game-server dev",
    "build": "pnpm typecheck && pnpm lint && pnpm --filter @3d/client build",
    "preview": "pnpm --filter @3d/client preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.node.json && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsx scripts/check.ts",
    "catalog": "tsx scripts/catalog.ts",
    "shots": "node packages/client/scripts/shots.mjs",
    "export:cod": "node scripts/venv-python.mjs -m scripts.cod export",
    "test:py": "node scripts/venv-python.mjs -m pytest",
    "lint:py": "node scripts/venv-python.mjs -m ruff check . && node scripts/venv-python.mjs -m ruff format --check .",
    "db:generate": "pnpm --filter @3d/api db:generate",
    "world": "pnpm --filter @3d/game-server world"
  },
  "dependencies": {
    "@preact/signals": "^2.11.2",
    "@preact/signals-core": "^1.14.4",
    "preact": "^10.29.8",
    "three": "^0.169.0",
    "three-mesh-bvh": "^0.8.3"
  },
  "devDependencies": {
    "@3d/api": "workspace:*",
    "@3d/client": "workspace:*",
    "@3d/game-server": "workspace:*",
    "@3d/shared": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^26.4.1",
    "@types/three": "^0.169.0",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.3",
    "playwright": "1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.28.1"
}
